{
  "name": "sql-studio-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "SQL Studio Electron desktop application",
  "author": "SQL Studio",
  "main": "src/main.cjs",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "start": "node scripts/desktop.cjs start",
    "build": "node scripts/desktop.cjs build",
    "pack": "node scripts/desktop.cjs pack",
    "dist": "node scripts/desktop.cjs dist",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.sqlstudio.desktop",
    "productName": "SQL Studio",
    "asar": true,
    "npmRebuild": false,
    "directories": { "output": "../release/electron" },
    "files": ["src/**/*.cjs", "package.json"],
    "extraResources": [{ "from": "runtime/backend", "to": "backend", "filter": ["sql-studio-backend.exe"] }],
    "electronDownload": { "mirror": "https://npmmirror.com/mirrors/electron/" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "artifactName": "SQL-Studio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "SQL-Studio-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": { "artifactName": "SQL-Studio-${version}-${arch}-portable.${ext}" }
  }
}
