    "/connections/{id}/session": {
      "post": {
        "operationId": "setConnectionSession",
        "summary": "打开或关闭连接/数据库",
        "tags": ["连接"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "完成打开验证，或目标范围底层资源已释放",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["open"],
                  "properties": {
                    "open": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入、JSON、数据库或上游服务错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "非本机 Host 或跨站请求被拒绝",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "连接不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "open 必填；database 省略为整个连接，指定非空库名时仅控制该库。关闭先拒绝新请求、取消在途请求，等待驱动连接释放后返回成功，最长 7 秒。打开测试实际连通性。不删除连接配置，不终止其他客户端会话。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["open"],
                "additionalProperties": false,
                "properties": {
                  "open": {
                    "type": "boolean"
                  },
                  "database": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": ["error"]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "service": {
            "type": "string",
            "enum": ["SQL Studio"]
          },
          "framework": {
            "type": "string",
            "enum": ["gin"]
          }
        },
        "required": ["status", "service", "framework"]
      },
      "Connection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "更新时携带已保存的连接 ID；新建可省略或留空。"
          },
          "type": {
            "type": "string",
            "enum": ["mysql", "mariadb", "postgresql", ""],
            "default": "mysql",
            "description": "省略或空字符串兼容为 mysql。"
          },
          "database": {
            "type": "string",
            "description": "PostgreSQL 维护库，省略或留空默认 postgres；MySQL/MariaDB 不使用。"
          },
          "tls": {
            "type": "boolean",
            "default": false
          },
          "name": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "default": "默认分组"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "description": "更新时留空保留原密码；任何响应都省略本字段。"
          },
          "hasPassword": {
            "type": "boolean",
            "readOnly": true
          }
        },
        "required": ["name", "host", "port", "username"],
        "additionalProperties": false
      },
      "SchemaName": {"type": "string"},
      "Table": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "对象类型 BASE TABLE 或 VIEW；PostgreSQL 表名保留完整双引号 schema/table 身份。"
          },
          "comment": {
            "type": "string"
          }
        },
        "required": ["name", "type", "comment"]
      },
      "Column": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "nullable": {
            "type": "string",
            "enum": ["YES", "NO"]
          },
          "key": {
            "type": "string"
          },
          "default": {
            "type": "string",
            "nullable": true
          },
          "extra": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "nullable",
          "key",
          "default",
          "extra",
          "comment"
        ]
      },
      "QueryRequest": {
        "type": "object",
        "properties": {
          "schema": {"type":"string","description":"可选 PostgreSQL schema，未指定沿用服务端默认搜索路径；MySQL/MariaDB 不接受独立 schema。"},
          "database": {
            "type": "string",
            "default": ""
          },
          "sql": {
            "type": "string",
            "minLength": 1,
            "example": "SELECT 1",
            "description": "非空、单语句；多条 SQL 由前端逐条请求。"
          },
          "limit": {
            "type": "integer",
            "default": 1000,
            "description": "小于等于 0 使用 1000，大于 5000 限制为 5000。"
          },
          "allowWrite": {
            "type": "boolean",
            "default": false,
              "description": "false 使用只读事务；MySQL/MariaDB 另拒绝非查询语句及可执行版本注释，防止 DDL 隐式提交绕过保护。显式 true 的写入自动提交。取消不代表回滚。"
          }
        },
        "required": ["sql"],
        "additionalProperties": false
      },
      "QueryResult": {
        "type": "object",
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": ["name", "type"]
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "nullable": true,
                "description": "NULL、字符串、数值或布尔；整数和 DECIMAL 使用字符串。"
              }
            }
          },
          "rowCount": {
            "type": "integer"
          },
          "affectedRows": {
            "type": "integer",
            "format": "int64"
          },
          "lastInsertId": {
            "type": "string"
          },
          "durationMs": {
            "type": "integer",
            "format": "int64"
          },
          "truncated": {
            "type": "boolean"
          },
          "isQuery": {
            "type": "boolean"
          }
        },
        "required": [
          "columns",
          "rows",
          "rowCount",
          "affectedRows",
          "lastInsertId",
          "durationMs",
          "truncated",
          "isQuery"
        ]
      },
      "AIConfig": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["deepseek"]
          },
          "model": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9._-]*$",
            "description": "更新省略或留空保留原模型；旧记录由服务商选择默认模型。"
          },
          "apiKey": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 512,
            "description": "首次填写；更新留空保留。响应省略此字段。"
          },
          "configured": {
            "type": "boolean",
            "readOnly": true,
            "description": "已配置为 true；未配置时可能省略。"
          },
          "completionEnabled": {
            "type": "boolean",
            "default": true,
            "description": "省略时保留旧值，首次默认 true。"
          }
        },
        "required": ["provider"]
      },
      "StateDocument": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [1]
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "description": "缺失分区为 0；保存后递增。"
          },
          "updatedAt": {
            "type": "string",
            "description": "RFC3339Nano 时间；缺失分区为空字符串。"
          },
          "data": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "缺失为 null；ai 分区按 AIConfig 脱敏，其他分区为业务对象。"
          },
          "extensions": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["schemaVersion", "revision", "updatedAt", "data"]
      },
      "StateWrite": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "最多 32 MiB；ai 分区遵守 AIConfig，密钥仅后端保存。"
          }
        },
        "required": ["revision", "data"],
        "additionalProperties": false
      },
      "AIRequest": {
        "type": "object",
        "properties": {
          "schema": {"type":"string","description":"可选 PostgreSQL schema，未指定沿用服务端默认搜索路径；MySQL/MariaDB 不接受独立 schema。"},
          "action": {
            "type": "string",
            "enum": ["complete", "optimize"]
          },
          "connectionId": {
            "type": "string",
            "default": "",
            "description": "可省略；提供时服务端校验连接并补充名称和引擎。"
          },
          "database": {
            "type": "string",
            "maxLength": 256,
            "default": ""
          },
          "table": {
            "type": "string",
            "maxLength": 256
          },
          "document": {
            "type": "string",
            "description": "草稿上下文，最多 64000 UTF-8 字节。"
          },
          "connection": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "description": "兼容输入；服务端忽略并按 connectionId 重建，不能伪造凭据。"
          },
          "sql": {
            "type": "string",
            "description": "optimize 时必填；与 prefix/suffix 合计最多 48000 字节。"
          },
          "prefix": {
            "type": "string",
            "description": "complete 时非空；保留光标前 SQL。"
          },
          "suffix": {
            "type": "string"
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 256
                },
                "comment": {
                  "type": "string",
                  "description": "最多 8000 字节。"
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "每字段最多 512 字节。"
                  },
                  "maxItems": 128
                }
              },
              "required": ["name", "columns"]
            },
            "maxItems": 12
          }
        },
        "required": ["action"],
        "additionalProperties": false
      },
      "AIResult": {
        "type": "object",
        "properties": {
          "completion": {
            "type": "string"
          },
          "sql": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        },
        "description": "complete 返回 completion（无建议时 {}）；optimize 返回 sql，可附 explanation。不执行 SQL。"
      },
      "AIModelsRequest": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["deepseek"]
          },
          "apiKey": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 512,
            "description": "省略时使用后端保存的 Key。"
          }
        },
        "required": ["provider"],
        "additionalProperties": false
      },
      "AIModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      },
      "Revision": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["revision"],
        "additionalProperties": false
      },
      "Index": {
        "type": "object",
        "required": ["name", "unique", "type", "columns"],
        "properties": {
          "name": {
            "type": "string",
            "description": "MySQL 主键为 PRIMARY；PostgreSQL 保留实际名称。"
          },
          "primary": {
            "type": "boolean",
            "description": "可选主键标志；PostgreSQL 不通过名称判断主键。"
          },
          "unique": {
            "type": "boolean"
          },
          "type": {
            "type": "string",
            "example": "BTREE"
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IndexColumn"
            }
          }
        }
      },
      "IndexColumn": {
        "type": "object",
        "required": ["name", "position", "prefixLength", "order"],
        "properties": {
          "name": {
            "type": "string",
            "description": "MySQL 表达式索引此值为空；PostgreSQL 返回表达式定义"
          },
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "prefixLength": {
            "type": "integer",
            "nullable": true,
            "minimum": 1
          },
          "order": {
            "type": "string",
            "enum": ["A", "D", ""],
            "description": "升序、降序或不适用"
          }
        }
      }
    }
  }
}
