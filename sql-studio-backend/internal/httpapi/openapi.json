              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE data JSON: rows(result QueryResult), done, error(error string). 心跳注释每10秒，必须收到done才成功。",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
