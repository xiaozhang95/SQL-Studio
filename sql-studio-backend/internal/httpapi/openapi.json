{
  "openapi": "3.0.3",
  "info": {
    "title": "SQL Studio API",
    "version": "1.0.0",
    "description": "本机单用户 API；仅允许本机 Host 与同源请求，无开放 CORS。成功直接返回 JSON；失败返回 {error:string}。所有 JSON 请求必须为单个对象，拒绝未知顶层字段。普通请求最多 1 MiB，配置写入例外。"
  },
  "servers": [
    {
      "url": "/api",
      "description": "当前服务同源 API"
    }
  ],
  "tags": [
    {
      "name": "服务"
    },
    {
      "name": "连接"
    },
    {
      "name": "元数据"
    },
    {
      "name": "查询"
    },
    {
      "name": "配置"
    },
    {
      "name": "AI"
    }
  ],
  "paths": {
    "/workspace": {
      "get": {
        "operationId": "readWorkspaceIndex",
        "summary": "读取轻量工作区索引，首次后端迁移旧JSON",
        "responses": {
          "200": {
            "description": "工作区索引或内容JSON"
          },
          "400": {
            "description": "无效请求或损坏的文件"
          },
          "403": {
            "description": "禁止访问"
          },
          "409": {
            "description": "修订冲突，不覆盖其他窗口"
          },
          "503": {
            "description": "服务未启用"
          }
        }
      },
      "put": {
        "operationId": "commitWorkspace",
        "summary": "只提交变化的草稿及结果，CAS原子提交索引",
        "responses": {
          "200": {
            "description": "工作区索引或内容JSON"
          },
          "400": {
            "description": "无效请求或损坏的文件"
          },
          "403": {
            "description": "禁止访问"
          },
          "409": {
            "description": "修订冲突，不覆盖其他窗口"
          },
          "503": {
            "description": "服务未启用"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "revision",
                  "index"
                ],
                "properties": {
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "index": {
                    "type": "object"
                  },
                  "drafts": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "results": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/workspace/parts/{id}": {
      "get": {
        "operationId": "readWorkspacePart",
        "summary": "按需读取不可变草稿或结果",
        "responses": {
          "200": {
            "description": "工作区索引或内容JSON"
          },
          "400": {
            "description": "无效请求或损坏的文件"
          },
          "403": {
            "description": "禁止访问"
          },
          "409": {
            "description": "修订冲突，不覆盖其他窗口"
          },
          "503": {
            "description": "服务未启用"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "服务健康（不测试数据库）",
        "tags": ["服务"],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
