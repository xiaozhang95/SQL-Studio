    "/connections/{id}/export-data": {
      "get": {
        "operationId": "streamTableExport",
        "summary": "SSE 流式导出表数据",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
