          },
          "403": {
            "description": "禁止访问"
          }
        }
      }
    },
    "/connections/{id}/query": {
      "post": {
        "operationId": "query",
        "summary": "执行一条 SQL",
        "tags": ["查询"],
        "description": "最长 30 秒，全进程 4 并发；默认 1000 行、最多 5000 行、约 8 MiB 字段内容。截断时 truncated=true，保留重复列名和精确数值文本。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResult"
                }
              }
            }
          },
          "400": {
            "description": "输入、JSON、数据库或上游服务错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "非本机 Host 或跨站请求被拒绝",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "连接不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "进程共享并发预算已满",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/state/{section}": {
      "get": {
        "operationId": "readState",
        "summary": "读取配置分区",
        "tags": ["配置"],
        "description": "workspace、history、appearance、ai 等独立分区；缺失返回 revision=0,data=null；ai 响应省略 apiKey。",
        "parameters": [
          {
            "name": "section",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,47}$"
            },
            "description": "配置分区名称；connections 为保留名称，读取和写入均返回 400。"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StateDocument"
                }
              }
            }
          },
          "400": {
            "description": "输入、JSON、数据库或上游服务错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "非本机 Host 或跨站请求被拒绝",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "对应模块未装配",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "writeState",
        "summary": "按修订号保存配置",
        "tags": ["配置"],
        "description": "data 必须为对象、最多 32 MiB，HTTP 信封最多 32 MiB + 1024 字节。已存在分区严格 CAS；缺失分区允许按会话旧 revision 重建。ai 数据遵守 AIConfig，响应脱敏。",
        "parameters": [
          {
